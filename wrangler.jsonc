{
  "name": "timer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "TIMER", "class_name": "TimerRoom" }
    ]
  },
  "exports": {
    "TimerRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "routes": [
    { "pattern": "timer.gervas.io", "custom_domain": true }
  ]
}
